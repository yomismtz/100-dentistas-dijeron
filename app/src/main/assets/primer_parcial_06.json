odoncia","Extrusión","Intrusión"],"correct":1},{"id":"parcial-120","category":"Nomenclatura","source":"Versión D","file":"3.docx","number":40,"type":"Nomenclatura · adaptada a opción múltiple","context":"","q":"La corona de un diente se desplaza hacia distal con ápice relativamente fijo. Forma el término con DISTO- + VERSIÓN.","options":["Intrusión","Distoversión","Extrusión","Micrognatia"],"correct":1}]